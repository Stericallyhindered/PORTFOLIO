<Window x:Class="Redline.Calibration.Desktop.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GCAL Vehicle Profiles" Width="1460" Height="900" MinWidth="1120" MinHeight="700"
        Background="{StaticResource WindowBrush}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="FieldStack" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
        <Border Background="#191A1D" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GCAL / CUSTOMER / VEHICLE" FontFamily="Segoe UI Semibold" FontSize="14" />
                    <TextBlock x:Name="VaultPathText" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="New Customer" Click="NewCustomer_Click" Margin="0,0,7,0" />
                    <Button Content="Add Vehicle" Click="NewVehicle_Click" Margin="0,0,7,0" />
                    <Button Content="New Build Revision" Click="NewBuild_Click" Margin="0,0,7,0" />
                    <Button Content="Export AI Profile" Click="ExportReview_Click" Margin="0,0,7,0" />
                    <Button Content="Save Profile" Style="{StaticResource AccentButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CustomerCombo" Grid.Row="1" DisplayMemberPath="DisplayName" SelectionChanged="CustomerCombo_SelectionChanged" Margin="0,0,0,16" />
                    <TextBlock Grid.Row="2" Text="VEHICLES" Style="{StaticResource FieldLabel}" />
                    <ListBox x:Name="VehicleList" Grid.Row="3" DisplayMemberPath="DisplayName" SelectionChanged="VehicleList_SelectionChanged" Background="Transparent" BorderBrush="{StaticResource LineBrush}" />
                    <TextBlock Grid.Row="4" Text="BUILD REVISIONS" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                    <ListBox x:Name="BuildList" Grid.Row="5" SelectionChanged="BuildList_SelectionChanged" Background="Transparent" BorderBrush="{StaticResource LineBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9"><Run Text="REV " /><Run Text="{Binding Revision}" /><Run Text=" · " /><Run Text="{Binding Status}" /></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <TabControl Grid.Column="1">
                <TabItem Header="PROFILE">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="CUSTOMER" Foreground="{StaticResource CyanBrush}" FontFamily="Segoe UI Semibold" Margin="0,0,0,10" />
                            <UniformGrid Columns="4">
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="DISPLAY NAME" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CustomerNameBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="COMPANY" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CustomerCompanyBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CustomerEmailBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="PHONE" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CustomerPhoneBox" /></StackPanel>
                            </UniformGrid>
                            <TextBox x:Name="CustomerNotesBox" AcceptsReturn="True" Height="54" TextWrapping="Wrap" ToolTip="Customer notes" />

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,16" />
                            <TextBlock Text="VEHICLE" Foreground="{StaticResource CyanBrush}" FontFamily="Segoe UI Semibold" Margin="0,0,0,10" />
                            <UniformGrid Columns="4">
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="PROFILE NAME" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VehicleNameBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="VIN" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VehicleVinBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="MODEL YEAR" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VehicleYearBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="MAKE" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VehicleMakeBox" Text="BMW" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VehicleModelBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="CHASSIS" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VehicleChassisBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="ENGINE FAMILY" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="VehicleEngineFamilyBox" IsEditable="True"><ComboBoxItem Content="B58" /><ComboBoxItem Content="S58" /></ComboBox></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="TRANSMISSION" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VehicleTransmissionBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="ODOMETER" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VehicleOdometerBox" /></StackPanel>
                            </UniformGrid>
                            <TextBox x:Name="VehicleNotesBox" AcceptsReturn="True" Height="54" TextWrapping="Wrap" ToolTip="Vehicle notes" />

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,16" />
                            <TextBlock Text="ENGINE COMBINATION" Foreground="{StaticResource CyanBrush}" FontFamily="Segoe UI Semibold" Margin="0,0,0,10" />
                            <UniformGrid Columns="4">
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="BUILD NAME" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildNameBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="REVISION" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildRevisionBox" IsReadOnly="True" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="BuildStatusBox" IsEditable="True"><ComboBoxItem Content="Draft" /><ComboBoxItem Content="Measured" /><ComboBoxItem Content="Assembled" /><ComboBoxItem Content="Verified" /></ComboBox></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="ENGINE CODE" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildEngineCodeBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="DISPLACEMENT CC" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildDisplacementBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="COMPRESSION RATIO" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildCompressionBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="BLOCK" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildBlockBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="CONNECTING RODS" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildRodsBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="PISTONS" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildPistonsBox" /></StackPanel>
                                <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="FUEL" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildFuelBox" /></StackPanel>
                            </UniformGrid>
                            <Expander Header="OPTIONAL SPECIFICATION DETAILS" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,14">
                                <UniformGrid Columns="4" Margin="0,12,0,0">
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="CYLINDERS" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildCylinderCountBox" Text="6" /></StackPanel>
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="MAIN JOURNALS" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildMainCountBox" Text="7" /></StackPanel>
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="BORE MM" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildBoreBox" /></StackPanel>
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="STROKE MM" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildStrokeBox" /></StackPanel>
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="CYLINDER HEAD" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildHeadBox" /></StackPanel>
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="CRANKSHAFT" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildCrankBox" /></StackPanel>
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="HEAD GASKET" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildGasketBox" /></StackPanel>
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="GASKET THICKNESS MM" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildGasketThicknessBox" /></StackPanel>
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="BUILDER" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BuildBuilderBox" /></StackPanel>
                                    <StackPanel Style="{StaticResource FieldStack}"><TextBlock Text="ASSEMBLY DATE" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="BuildAssemblyDatePicker" /></StackPanel>
                                </UniformGrid>
                            </Expander>
                            <TextBlock Text="BUILD / ASSEMBLY NOTES" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="BuildNotesBox" AcceptsReturn="True" Height="130" TextWrapping="Wrap" ToolTip="Engine build and assembly notes" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="OPTIONAL MEASUREMENTS">
                    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Add Measurement" Click="AddMeasurement_Click" Margin="0,0,7,0" /><Button Content="Delete Selected" Click="DeleteMeasurement_Click" Margin="0,0,7,0" /><Button Content="Clear All" Click="ClearMeasurements_Click" /></StackPanel>
                        <DataGrid x:Name="MeasurementsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" FrozenColumnCount="3">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SYSTEM" Binding="{Binding System}" Width="140" /><DataGridTextColumn Header="COMPONENT" Binding="{Binding Component}" Width="140" />
                                <DataGridTextColumn Header="POSITION" Binding="{Binding Position}" Width="120" /><DataGridTextColumn Header="SPECIFICATION" Binding="{Binding Specification}" Width="210" />
                                <DataGridTextColumn Header="TARGET" Binding="{Binding TargetValue}" Width="80" /><DataGridTextColumn Header="ACTUAL" Binding="{Binding ActualValue}" Width="80" />
                                <DataGridTextColumn Header="MIN" Binding="{Binding MinimumValue}" Width="75" /><DataGridTextColumn Header="MAX" Binding="{Binding MaximumValue}" Width="75" />
                                <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="70" /><DataGridTextColumn Header="METHOD" Binding="{Binding Method}" Width="140" />
                                <DataGridTextColumn Header="INSTRUMENT" Binding="{Binding Instrument}" Width="140" /><DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="180" />
                                <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="OPTIONAL ASSEMBLY RECORDS">
                    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Add Event" Click="AddFastener_Click" Margin="0,0,7,0" /><Button Content="Delete Selected" Click="DeleteFastener_Click" Margin="0,0,7,0" /><Button Content="Clear All" Click="ClearFasteners_Click" /></StackPanel>
                        <DataGrid x:Name="FastenersGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" FrozenColumnCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GROUP" Binding="{Binding FastenerGroup}" Width="170" /><DataGridTextColumn Header="POSITION / EVENT" Binding="{Binding Position}" Width="180" />
                                <DataGridTextColumn Header="MFR" Binding="{Binding Manufacturer}" Width="110" /><DataGridTextColumn Header="PART" Binding="{Binding PartNumber}" Width="120" />
                                <DataGridTextColumn Header="CYCLE" Binding="{Binding InstallationCycle}" Width="65" /><DataGridTextColumn Header="TORQUE NM" Binding="{Binding TorqueNm}" Width="90" />
                                <DataGridTextColumn Header="ANGLE DEG" Binding="{Binding AngleDegrees}" Width="90" /><DataGridTextColumn Header="STRETCH MM" Binding="{Binding StretchMm}" Width="95" />
                                <DataGridTextColumn Header="LUBRICANT" Binding="{Binding Lubricant}" Width="130" /><DataGridTextColumn Header="PROCEDURE SOURCE" Binding="{Binding ProcedureSource}" Width="180" />
                                <DataGridTextColumn Header="PERFORMED UTC" Binding="{Binding PerformedUtc}" Width="160" /><DataGridTextColumn Header="TECHNICIAN" Binding="{Binding Technician}" Width="120" />
                                <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="HARDWARE">
                    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Add Component" Click="AddHardware_Click" Margin="0,0,7,0" /><Button Content="Delete Selected" Click="DeleteHardware_Click" /></StackPanel>
                        <DataGrid x:Name="HardwareGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" FrozenColumnCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SYSTEM" Binding="{Binding System}" Width="160" /><DataGridTextColumn Header="COMPONENT" Binding="{Binding ComponentType}" Width="160" />
                                <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Manufacturer}" Width="130" /><DataGridTextColumn Header="MODEL" Binding="{Binding Model}" Width="140" />
                                <DataGridTextColumn Header="PART NUMBER" Binding="{Binding PartNumber}" Width="130" /><DataGridTextColumn Header="SERIAL" Binding="{Binding SerialNumber}" Width="120" />
                                <DataGridTextColumn Header="RATED VALUE" Binding="{Binding RatedValue}" Width="95" /><DataGridTextColumn Header="UNIT" Binding="{Binding RatedUnit}" Width="80" />
                                <DataGridTextColumn Header="CALIBRATION DATA" Binding="{Binding CalibrationData}" Width="240" /><DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="240" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="CALIBRATION FILES">
                    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Import BIN / XDF / Logs" Click="ImportAssets_Click" />
                            <TextBlock Text="FILES ARE COPIED INTO THE LOCAL SHA-256 VAULT" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="9" />
                        </StackPanel>
                        <DataGrid x:Name="AssetsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="75" />
                                <DataGridTextColumn Header="ORIGINAL FILE" Binding="{Binding OriginalFileName}" Width="280" />
                                <DataGridTextColumn Header="SIZE" Binding="{Binding SizeBytes}" Width="100" />
                                <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="430" />
                                <DataGridTextColumn Header="SOFTWARE ID" Binding="{Binding SoftwareId}" Width="150" />
                                <DataGridTextColumn Header="IMPORTED UTC" Binding="{Binding ImportedUtc}" Width="180" />
                                <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="240" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="#17181A" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="ProfileStatusText" Text="LOCAL PROFILE VAULT" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0" FontSize="10" />
        </Border>
    </Grid>
</Window>
